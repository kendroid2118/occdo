# Copy to .env for local development. Never commit real values.
# PostgreSQL connection string (required)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/occdo"

# Auth.js session secret — generate a long random string (required, min 32 chars)
AUTH_SECRET="replace-with-a-long-random-secret"

# Optional: set to "production" on Hostinger
NODE_ENV="development"

# Optional: Upstash Redis for rate limiting (M1)
# UPSTASH_REDIS_REST_URL="https://example.upstash.io"
# UPSTASH_REDIS_REST_TOKEN="replace-me"

# Optional: public site URL (Hostinger / reverse proxy)
# AUTH_URL="https://example.com"
# Enable Auth.js trustHost only behind a known reverse proxy (Hostinger).
# AUTH_TRUST_HOST="true"

# Optional development seed users (never used in production seed)
# SEED_DEMO_EMAIL="demo.user@occdo.local"
# SEED_DEMO_ADMIN_EMAIL="demo.admin@occdo.local"
# SEED_DEMO_PASSWORD="replace-with-local-demo-password"
