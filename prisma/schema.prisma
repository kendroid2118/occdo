generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Minimal bootstrap row from M0.
model AppMeta {
  id        String   @id @default("occdo")
  name      String   @default("OCCDO")
  createdAt DateTime @default(now())
}

enum Role {
  DEVELOPER
  SUPER_ADMIN
  ADMIN
  USER
}

/// Constrained event kind for Capacity Building. Not a free-form string.
enum TrainingKind {
  TRAINING
  SEMINAR
  ORIENTATION
}

/// Constrained attendance value for training participants.
enum AttendanceStatus {
  REGISTERED
  PRESENT
  ABSENT
}

/// Constrained fund-monitoring movement. Amounts are always stored positive.
enum FundLedgerEntryKind {
  DISBURSEMENT
  ADJUSTMENT
  RECOVERY
}

/// Office calendar items. Do not duplicate TrainingEvent or other domain records.
enum CalendarActivityKind {
  ACTIVITY
  TRAINING
  DEADLINE
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  /// bcrypt/argon hash only. Never plaintext. Never selected by UI DAL helpers.
  passwordHash  String?
  role          Role      @default(USER)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  accounts              Account[]
  sessions              Session[]
  auditLogs             AuditLog[]
  cooperativesCreated   Cooperative[] @relation("CooperativeCreatedBy")
  cooperativesUpdated   Cooperative[] @relation("CooperativeUpdatedBy")
  membershipSnapshots          MembershipSnapshot[]
  accreditationCasesCreated    AccreditationCase[]  @relation("AccreditationCaseCreatedBy")
  accreditationCasesUpdated    AccreditationCase[]  @relation("AccreditationCaseUpdatedBy")
  serviceDeliveriesRecorded    ServiceDelivery[]
  trainingEventsCreated        TrainingEvent[]  @relation("TrainingEventCreatedBy")
  trainingEventsUpdated        TrainingEvent[]  @relation("TrainingEventUpdatedBy")
  assistanceRecordsCreated     AssistanceRecord[] @relation("AssistanceRecordCreatedBy")
  assistanceRecordsUpdated     AssistanceRecord[] @relation("AssistanceRecordUpdatedBy")
  fundLedgerEntriesRecorded    FundLedgerEntry[]
  complianceRecordsCreated     ComplianceRecord[] @relation("ComplianceRecordCreatedBy")
  complianceRecordsVerified    ComplianceRecord[] @relation("ComplianceRecordVerifiedBy")
  documentsUploaded            CooperativeDocument[] @relation("DocumentUploadedBy")
  documentsVerified            CooperativeDocument[] @relation("DocumentVerifiedBy")
  calendarActivitiesCreated    CalendarActivity[] @relation("CalendarActivityCreatedBy")
  calendarActivitiesUpdated    CalendarActivity[] @relation("CalendarActivityUpdatedBy")
  announcementsCreated         Announcement[]     @relation("AnnouncementCreatedBy")
  announcementsUpdated         Announcement[]     @relation("AnnouncementUpdatedBy")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String
  occurredAt DateTime @default(now())
  source     String   @default("WEB")
  metadata   Json?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([entityType, entityId])
  @@index([occurredAt])
}

model CooperativeType {
  id            String        @id @default(cuid())
  code          String        @unique
  name          String
  description   String?
  sortOrder     Int           @default(0)
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  cooperatives  Cooperative[]

  @@index([isActive, sortOrder])
}

model CooperativeSector {
  id            String        @id @default(cuid())
  code          String        @unique
  name          String
  description   String?
  sortOrder     Int           @default(0)
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  cooperatives  Cooperative[]

  @@index([isActive, sortOrder])
}

model CooperativeStatus {
  id            String        @id @default(cuid())
  code          String        @unique
  name          String
  description   String?
  sortOrder     Int           @default(0)
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  cooperatives  Cooperative[]

  @@index([isActive, sortOrder])
}

model AccreditationStatus {
  id            String        @id @default(cuid())
  code          String        @unique
  name          String
  description   String?
  sortOrder     Int           @default(0)
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  cooperatives  Cooperative[]

  @@index([isActive, sortOrder])
}

model Barangay {
  id            String        @id @default(cuid())
  code          String        @unique
  name          String
  description   String?
  sortOrder     Int           @default(0)
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  cooperatives  Cooperative[]

  @@index([isActive, sortOrder])
}

model Cooperative {
  id                    String              @id @default(cuid())
  cooperativeCode       String              @unique
  registrationNumber    String?             @unique
  name                  String
  acronym               String?
  typeId                String
  sectorId              String
  address               String
  barangayId            String
  contactPerson         String
  contactNumber         String
  email                 String?
  dateRegistered        DateTime?
  dateAccredited        DateTime?
  accreditationStatusId String
  statusId              String
  totalMembers          Int                 @default(0)
  maleMembers           Int                 @default(0)
  femaleMembers         Int                 @default(0)
  remarks               String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  createdById           String
  updatedById           String
  type                  CooperativeType     @relation(fields: [typeId], references: [id], onDelete: Restrict)
  sector                CooperativeSector   @relation(fields: [sectorId], references: [id], onDelete: Restrict)
  barangay              Barangay            @relation(fields: [barangayId], references: [id], onDelete: Restrict)
  accreditationStatus   AccreditationStatus @relation(fields: [accreditationStatusId], references: [id], onDelete: Restrict)
  status                CooperativeStatus   @relation(fields: [statusId], references: [id], onDelete: Restrict)
  createdBy             User                @relation("CooperativeCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy             User                @relation("CooperativeUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  officers              CooperativeOfficer[]
  membershipSnapshots   MembershipSnapshot[]
  accreditationCases    AccreditationCase[]
  serviceDeliveries     ServiceDelivery[]
  trainingParticipants  TrainingParticipant[]
  assistanceRecords     AssistanceRecord[]
  complianceRecords     ComplianceRecord[]
  documents             CooperativeDocument[]
  calendarActivities    CalendarActivity[]

  @@index([name])
  @@index([typeId])
  @@index([sectorId])
  @@index([barangayId])
  @@index([statusId])
  @@index([accreditationStatusId])
  @@index([dateRegistered])
  @@index([dateAccredited])
}

model OfficerPosition {
  id           String                @id @default(cuid())
  code         String                @unique
  name         String
  description  String?
  sortOrder    Int                   @default(0)
  isActive     Boolean               @default(true)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  officers     CooperativeOfficer[]

  @@index([isActive, sortOrder])
}

model CooperativeOfficer {
  id                String          @id @default(cuid())
  cooperativeId     String
  positionId        String
  fullName          String
  contactNumber     String?
  email             String?
  isPrimaryContact  Boolean         @default(false)
  startDate         DateTime?
  endDate           DateTime?
  isActive          Boolean         @default(true)
  remarks           String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  cooperative       Cooperative     @relation(fields: [cooperativeId], references: [id], onDelete: Cascade)
  position          OfficerPosition @relation(fields: [positionId], references: [id], onDelete: Restrict)

  @@index([cooperativeId])
  @@index([positionId])
  @@index([cooperativeId, isPrimaryContact])
}

/// Male + female need not equal total until OCCDO confirms that rule.
model MembershipSnapshot {
  id             String      @id @default(cuid())
  cooperativeId  String
  asOfDate       DateTime    @db.Date
  totalMembers   Int         @default(0)
  maleMembers    Int         @default(0)
  femaleMembers  Int         @default(0)
  source         String
  recordedById   String
  createdAt      DateTime    @default(now())
  cooperative    Cooperative @relation(fields: [cooperativeId], references: [id], onDelete: Cascade)
  recordedBy     User        @relation(fields: [recordedById], references: [id], onDelete: Restrict)

  @@unique([cooperativeId, asOfDate])
  @@index([cooperativeId])
}

model AccreditationCaseType {
  id          String              @id @default(cuid())
  code        String              @unique
  name        String
  description String?
  sortOrder   Int                 @default(0)
  isActive    Boolean             @default(true)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  cases       AccreditationCase[]

  @@index([isActive, sortOrder])
}

model AccreditationCaseStatus {
  id          String              @id @default(cuid())
  code        String              @unique
  name        String
  description String?
  sortOrder   Int                 @default(0)
  isActive    Boolean             @default(true)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  cases       AccreditationCase[]

  @@index([isActive, sortOrder])
}

model AccreditationCase {
  id            String                   @id @default(cuid())
  cooperativeId String
  typeId        String
  statusId      String
  filedAt       DateTime                 @default(now())
  decidedAt     DateTime?
  remarks       String?
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt
  createdById   String
  updatedById   String
  cooperative   Cooperative              @relation(fields: [cooperativeId], references: [id], onDelete: Cascade)
  type          AccreditationCaseType    @relation(fields: [typeId], references: [id], onDelete: Restrict)
  status        AccreditationCaseStatus  @relation(fields: [statusId], references: [id], onDelete: Restrict)
  createdBy     User                     @relation("AccreditationCaseCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy     User                     @relation("AccreditationCaseUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)

  @@index([cooperativeId])
  @@index([typeId])
  @@index([statusId])
}

model Program {
  id              String            @id @default(cuid())
  code            String            @unique
  name            String
  description     String?
  sortOrder       Int               @default(0)
  isActive        Boolean           @default(true)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  deliveries      ServiceDelivery[]
  trainingEvents  TrainingEvent[]

  @@index([isActive, sortOrder])
}

model ServiceType {
  id              String            @id @default(cuid())
  code            String            @unique
  name            String
  description     String?
  sortOrder       Int               @default(0)
  isActive        Boolean           @default(true)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  deliveries      ServiceDelivery[]
  trainingEvents  TrainingEvent[]

  @@index([isActive, sortOrder])
}

model ServiceDelivery {
  id              String       @id @default(cuid())
  cooperativeId   String
  programId       String?
  serviceTypeId   String
  deliveredAt     DateTime
  remarks         String?
  recordedById    String
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  cooperative     Cooperative  @relation(fields: [cooperativeId], references: [id], onDelete: Cascade)
  program         Program?     @relation(fields: [programId], references: [id], onDelete: Restrict)
  serviceType     ServiceType  @relation(fields: [serviceTypeId], references: [id], onDelete: Restrict)
  recordedBy      User         @relation(fields: [recordedById], references: [id], onDelete: Restrict)

  @@index([cooperativeId])
  @@index([serviceTypeId, deliveredAt])
  @@index([deliveredAt])
}

model TrainingEvent {
  id             String       @id @default(cuid())
  title          String
  kind           TrainingKind
  startAt        DateTime
  endAt          DateTime?
  venue          String
  programId      String?
  serviceTypeId  String?
  remarks        String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  createdById    String
  updatedById    String
  program        Program?     @relation(fields: [programId], references: [id], onDelete: Restrict)
  serviceType    ServiceType? @relation(fields: [serviceTypeId], references: [id], onDelete: Restrict)
  createdBy      User         @relation("TrainingEventCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy      User         @relation("TrainingEventUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  participants   TrainingParticipant[]
  calendarActivities CalendarActivity[]

  @@index([kind])
  @@index([startAt])
  @@index([programId])
  @@index([serviceTypeId])
}

model TrainingParticipant {
  id                String            @id @default(cuid())
  trainingEventId   String
  cooperativeId     String?
  fullName          String
  attendanceStatus  AttendanceStatus  @default(REGISTERED)
  contactNumber     String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  trainingEvent     TrainingEvent     @relation(fields: [trainingEventId], references: [id], onDelete: Cascade)
  cooperative       Cooperative?      @relation(fields: [cooperativeId], references: [id], onDelete: Restrict)

  @@index([trainingEventId])
  @@index([cooperativeId])
}

model AssistanceType {
  id          String             @id @default(cuid())
  code        String             @unique
  name        String
  description String?
  sortOrder   Int                @default(0)
  isActive    Boolean            @default(true)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  records     AssistanceRecord[]

  @@index([isActive, sortOrder])
}

model AssistanceStatus {
  id          String             @id @default(cuid())
  code        String             @unique
  name        String
  description String?
  sortOrder   Int                @default(0)
  isActive    Boolean            @default(true)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  records     AssistanceRecord[]

  @@index([isActive, sortOrder])
}

model AssistanceRecord {
  id                String            @id @default(cuid())
  cooperativeId     String
  assistanceTypeId  String
  amount            Decimal           @db.Decimal(14, 2)
  requestedAt       DateTime
  approvedAt        DateTime?
  releasedAt        DateTime?
  statusId          String
  fundSource        String?
  remarks           String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  createdById       String
  updatedById       String
  cooperative       Cooperative       @relation(fields: [cooperativeId], references: [id], onDelete: Cascade)
  assistanceType    AssistanceType    @relation(fields: [assistanceTypeId], references: [id], onDelete: Restrict)
  status            AssistanceStatus  @relation(fields: [statusId], references: [id], onDelete: Restrict)
  createdBy         User              @relation("AssistanceRecordCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy         User              @relation("AssistanceRecordUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  ledgerEntries     FundLedgerEntry[]

  @@index([cooperativeId])
  @@index([assistanceTypeId])
  @@index([statusId])
  @@index([requestedAt])
}

model FundLedgerEntry {
  id                  String               @id @default(cuid())
  assistanceRecordId  String
  entryDate           DateTime
  amount              Decimal              @db.Decimal(14, 2)
  entryKind           FundLedgerEntryKind
  remarks             String?
  createdAt           DateTime             @default(now())
  recordedById        String
  assistanceRecord    AssistanceRecord     @relation(fields: [assistanceRecordId], references: [id], onDelete: Cascade)
  recordedBy          User                 @relation(fields: [recordedById], references: [id], onDelete: Restrict)

  @@index([assistanceRecordId, entryDate])
  @@index([entryKind])
}

/// Configurable compliance checklist item. Do not hardcode requirement lists in application logic.
model ComplianceRequirement {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  frequency   String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  records     ComplianceRecord[]

  @@index([isActive, sortOrder])
}

model ComplianceStatus {
  id          String             @id @default(cuid())
  code        String             @unique
  name        String
  description String?
  sortOrder   Int                @default(0)
  isActive    Boolean            @default(true)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  records     ComplianceRecord[]

  @@index([isActive, sortOrder])
}

model ComplianceRecord {
  id               String                 @id @default(cuid())
  cooperativeId    String
  requirementId    String
  reportingPeriod  String
  dueDate          DateTime
  submittedDate    DateTime?
  statusId         String
  remarks          String?
  verifiedById     String?
  verifiedAt       DateTime?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  createdById      String
  cooperative      Cooperative            @relation(fields: [cooperativeId], references: [id], onDelete: Cascade)
  requirement      ComplianceRequirement  @relation(fields: [requirementId], references: [id], onDelete: Restrict)
  status           ComplianceStatus       @relation(fields: [statusId], references: [id], onDelete: Restrict)
  createdBy        User                   @relation("ComplianceRecordCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  verifiedBy       User?                  @relation("ComplianceRecordVerifiedBy", fields: [verifiedById], references: [id], onDelete: Restrict)

  @@unique([cooperativeId, requirementId, reportingPeriod])
  @@index([cooperativeId])
  @@index([requirementId])
  @@index([statusId])
  @@index([dueDate])
}

/// Configurable document classification. Not a hardcoded application list.
model DocumentType {
  id          String                @id @default(cuid())
  code        String                @unique
  name        String
  description String?
  sortOrder   Int                   @default(0)
  isActive    Boolean               @default(true)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  documents   CooperativeDocument[]

  @@index([isActive, sortOrder])
}

/// Cooperative-scoped upload metadata. storedFilename is server-generated and is never a client path.
model CooperativeDocument {
  id                  String        @id @default(cuid())
  cooperativeId       String
  documentTypeId      String
  reportingPeriod     String?
  originalFilename    String
  storedFilename      String        @unique
  mimeType            String
  sizeBytes           Int
  verificationStatus  String        @default("UNVERIFIED")
  uploadedAt          DateTime      @default(now())
  uploadedById        String
  verifiedAt          DateTime?
  verifiedById        String?
  cooperative         Cooperative   @relation(fields: [cooperativeId], references: [id], onDelete: Cascade)
  documentType        DocumentType  @relation(fields: [documentTypeId], references: [id], onDelete: Restrict)
  uploadedBy          User          @relation("DocumentUploadedBy", fields: [uploadedById], references: [id], onDelete: Restrict)
  verifiedBy          User?         @relation("DocumentVerifiedBy", fields: [verifiedById], references: [id], onDelete: Restrict)

  @@index([cooperativeId])
  @@index([documentTypeId])
  @@index([uploadedAt])
  @@index([verificationStatus])
}

/// Office-level template/form catalog. Metadata only in M9; no public file URLs.
model DocumentTemplate {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive, sortOrder])
}

/// Office/calendar activities. Optional links to Cooperative or TrainingEvent; do not copy those records.
model CalendarActivity {
  id              String               @id @default(cuid())
  title           String
  kind            CalendarActivityKind
  startAt         DateTime
  endAt           DateTime?
  location        String?
  remarks         String?
  cooperativeId   String?
  trainingEventId String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  createdById     String
  updatedById     String
  cooperative     Cooperative?         @relation(fields: [cooperativeId], references: [id], onDelete: Restrict)
  trainingEvent   TrainingEvent?       @relation(fields: [trainingEventId], references: [id], onDelete: Restrict)
  createdBy       User                 @relation("CalendarActivityCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy       User                 @relation("CalendarActivityUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)

  @@index([startAt])
  @@index([kind])
  @@index([cooperativeId])
  @@index([trainingEventId])
}

/// Dashboard announcements. Body is stored and rendered as plain text.
model Announcement {
  id          String    @id @default(cuid())
  title       String
  body        String
  publishedAt DateTime
  expiresAt   DateTime?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String
  updatedById String
  createdBy   User      @relation("AnnouncementCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy   User      @relation("AnnouncementUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)

  @@index([publishedAt])
  @@index([isActive, publishedAt])
  @@index([expiresAt])
}
